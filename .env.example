# Copy to .env and fill in. Never commit .env.
# Public base URL. http://127.0.0.1:<port> uses the loopback (dev) OAuth client.
PUBLIC_URL=https://parlor.cruftmanor.com
HOST=127.0.0.1
PORT=8790
DB_PATH=./data/parlor.db
# 64 hex chars; encrypts OAuth sessions at rest. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_KEY=
SPACE_TYPE=com.cruftmanor.parlor.space
MESSAGE_COLLECTION=com.cruftmanor.parlor.message
MAX_MESSAGE_LENGTH=1000
# Attachment caps in bytes (default 12 MB each, under the server's
# mod_security request body limit), and uploads per user per minute.
MAX_IMAGE_BYTES=12582912
MAX_PDF_BYTES=12582912
UPLOADS_PER_MINUTE=5
# Optional: comma-separated DIDs allowed to sign in (empty = anyone)
ALLOWED_DIDS=
