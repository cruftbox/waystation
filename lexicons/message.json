{
  "lexicon": 1,
  "id": "com.cruftmanor.parlor.message",
  "defs": {
    "main": {
      "type": "record",
      "description": "A chat message, written into the author's own repo in a Parlor space.",
      "key": "tid",
      "record": {
        "type": "object",
        "required": ["text", "createdAt"],
        "properties": {
          "text": { "type": "string", "maxLength": 10000, "maxGraphemes": 1000 },
          "createdAt": { "type": "string", "format": "datetime" }
        }
      }
    }
  }
}
